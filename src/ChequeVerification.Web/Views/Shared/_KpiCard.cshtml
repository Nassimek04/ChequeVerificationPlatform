@model ChequeVerification.Web.ViewModels.Dashboard.KpiCardViewModel

<div class="col-6 col-xl-3 mb-3">
    <div class="card kpi-card h-100">
        <div class="card-body">
            <span class="kpi-dot" aria-hidden="true"></span>
            <div class="kpi-label">@Model.Label</div>
            <div class="kpi-value">@Model.Value</div>
        </div>
    </div>
</div>
