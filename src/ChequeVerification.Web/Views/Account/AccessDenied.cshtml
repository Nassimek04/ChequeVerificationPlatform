@{
    ViewData["Title"] = "Accès refusé";
}

<div class="auth-status-card">
    <span class="auth-status-code">Erreur 403 — Accès refusé</span>
    <h1 class="h4 mb-2">Vous n'avez pas accès à cette page</h1>
    <p class="text-muted mb-4">Votre rôle ne permet pas de consulter cette section. Si vous pensez qu'il s'agit d'une erreur, contactez votre administrateur.</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Retour à l'accueil</a>
</div>
