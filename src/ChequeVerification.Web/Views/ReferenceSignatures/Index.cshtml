@model ChequeVerification.Web.ViewModels.ReferenceSignatures.ReferenceSignatureListViewModel
@using ChequeVerification.Web.ViewModels.Shared
@{
    ViewData["Title"] = "Signatures de référence";
}

<partial name="_PageHeader" model='new PageHeaderViewModel { Eyebrow = "Opérations", Title = "Signatures de référence", Subtitle = "Signatures de comparaison enregistrées pour les clients." }' />

<form method="get" asp-action="Index" class="app-search mb-3" role="search">
    <div class="input-group" style="max-width: 460px;">
        <label class="visually-hidden" for="signatureSearch">Rechercher une signature</label>
        <input type="text" id="signatureSearch" name="search" value="@Model.SearchTerm" class="form-control"
               placeholder="Rechercher (n° client, nom...)" />
        <button type="submit" class="btn btn-outline-secondary">Rechercher</button>
        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Réinitialiser</a>
        }
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Client</th>
                    <th>N° client</th>
                    <th>Signature</th>
                    <th>Aperçu</th>
                    <th>État</th>
                    <th>Créée le</th>
                    <th><span class="visually-hidden">Action</span></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Signatures.Any())
                {
                    foreach (var s in Model.Signatures)
                    {
                        <tr>
                            <td><span class="record-primary">@s.CustomerFullName</span></td>
                            <td class="record-secondary">@s.CustomerNumber</td>
                            <td class="record-secondary cell-num">#@s.ReferenceSignatureId</td>
                            <td>
                                <img src="@s.ImagePath" alt="Signature de référence du client @s.CustomerFullName" class="img-thumb"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='inline';" /><span class="text-muted small" style="display:none;">Aperçu indisponible</span>
                            </td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="cell-date">@s.CreatedAt.ToString("g")</td>
                            <td class="table-actions">
                                <a asp-action="Details" asp-route-id="@s.ReferenceSignatureId" class="btn btn-sm btn-outline-secondary">Détails</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="app-empty">Aucune signature de référence trouvée.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Pagination des signatures">
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.SearchTerm" asp-route-page="@(Model.Page - 1)">Précédent</a>
            </li>
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-search="@Model.SearchTerm" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.SearchTerm" asp-route-page="@(Model.Page + 1)">Suivant</a>
            </li>
        </ul>
    </nav>
}

<p class="app-meta mt-2">@Model.TotalCount signature(s) au total.</p>
