# Verification API - environment configuration
# Copy this file to .env and adjust values as needed.

# Application
APP_NAME=verification-api
APP_VERSION=0.1.0
# Environment: "development" enables the development-only endpoints
# (e.g. POST /api/signatures/debug). Any other value disables them.
APP_ENV=development

# Server
HOST=0.0.0.0
PORT=8000

# Allowed ASP.NET origins (comma-separated). Local development only.
# CORS_ORIGINS=http://localhost:5285,http://127.0.0.1:5285
CORS_ORIGINS=http://localhost:5285,http://127.0.0.1:5285

# --- Experimental signature extraction (relative ratios 0..1) ---
# Candidate region of interest. The strategy assumes the signature sits in
# the bottom-right area of a standard cheque. NOT universal: calibrate on the
# real cheque formats used during the internship.
# Must satisfy: 0 <= start < end <= 1 on each axis.
SIGNATURE_ROI_X_START=0.40
SIGNATURE_ROI_Y_START=0.40
SIGNATURE_ROI_X_END=0.98
SIGNATURE_ROI_Y_END=0.98

# Padding added around the detected ink bounding box (fraction of bbox size).
SIGNATURE_BBOX_MARGIN=0.08

# --- V2.1: ink filtering (all ratios relative to the full ROI) ---
# Bottom band of the ROI flagged as a "MICR risk zone" (fraction of ROI
# height). NOT physically removed: the whole ROI is analyzed, only components
# looking like MICR / printed text inside this band are rejected. Historical
# name kept for compatibility.
SIGNATURE_BOTTOM_EXCLUSION_RATIO=0.10
# Drop components smaller than this fraction of the ROI area (specks).
SIGNATURE_MIN_COMPONENT_AREA_RATIO=0.0005
# Drop a component covering more than this fraction of the ROI area.
SIGNATURE_MAX_COMPONENT_AREA_RATIO=0.60
# Drop components thinner than these fractions of the ROI width/height.
SIGNATURE_MIN_COMPONENT_WIDTH_RATIO=0.01
SIGNATURE_MIN_COMPONENT_HEIGHT_RATIO=0.01
# V2.1 MICR/printed rejection (components inside the risk zone only):
# - "very horizontal" when width/height exceeds this aspect ratio.
SIGNATURE_MICR_MIN_ASPECT_RATIO=6.0
# - "short and wide" when height ratio < this AND width ratio >= this.
#   Tight threshold (V2.1: 0.12) so a long diagonal signature stroke entering
#   the band is NOT mistaken for a printed character.
SIGNATURE_MICR_MAX_HEIGHT_RATIO=0.06
SIGNATURE_MICR_MIN_WIDTH_RATIO=0.03
# V2.2 grouping: two components join the same signature group when both the
# horizontal and vertical gap (as fractions of ROI width/height) are within
# this value. Tighter than V2.1 (0.15) so an isolated printed component near
# the signature does not merge into its group.
SIGNATURE_COMPONENT_MERGE_DISTANCE_RATIO=0.10
# V2.1: minimum components a group needs to be eligible as primary signature.
SIGNATURE_GROUP_MIN_COMPONENTS=1
# Morphology close kernel (odd integer 1..9), kept small on purpose.
SIGNATURE_MORPH_KERNEL_SIZE=3
# V2.3 dominant-core refinement (second stage on the selected V2.2 group):
# - max ink Chebyshev distance (fraction of ROI width) from an accepted
#   component to a candidate for it to join the refined structure. Calibrated
#   so printed content at 9-24px is excluded while genuine strokes within
#   ~8px are preserved on the real CHQ-0002.
SIGNATURE_CORE_INK_DISTANCE_RATIO=0.018
# - bbox same-pair gaps (fractions of ROI width/height): horizontal and
#   vertical gap are measured against the SAME accepted component.
SIGNATURE_CORE_MAX_H_GAP_RATIO=0.15
SIGNATURE_CORE_MAX_V_GAP_RATIO=0.15
# - minimum height (fraction of ROI height) for a candidate component
#   (printed text / specks are short).
SIGNATURE_CORE_MIN_HEIGHT_RATIO=0.08

# --- Experimental signature comparison V1 (fixed normalization canvas) ---
# Both signatures are resized preserving the aspect ratio (no distortion) and
# centered on a canvas of this size before the similarity metrics are computed.
# Canvas is width x height, each axis between 32 and 1024.
SIGNATURE_COMPARISON_CANVAS_WIDTH=256
SIGNATURE_COMPARISON_CANVAS_HEIGHT=128

# --- AI V2 signature verification (experimental metric model) ---
# Enables the dedicated POST /api/signatures/compare-ai endpoint (raw cosine
# similarity between AI V2 embeddings). When disabled, the app starts normally
# and the AI endpoint returns a controlled "unavailable" response; the OpenCV
# baseline /api/signatures/compare keeps working.
SIGNATURE_AI_ENABLED=true
# Checkpoint path (absolute, or relative to the service root).
SIGNATURE_AI_CHECKPOINT=ai/checkpoints/metric_resnet18_v2.pt
# Device: "auto" (CUDA if available, otherwise CPU), "cuda", or "cpu".
# CUDA is never required.
SIGNATURE_AI_DEVICE=auto

# --- PaddleOCR Docker Linux worker V1 ---
# Windows native libpaddle.pyd is blocked by Smart App Control.
# Paddle runs only inside Docker Linux; main FastAPI proxies via HTTP.
OCR_WORKER_URL=http://127.0.0.1:8010
OCR_WORKER_TIMEOUT=60