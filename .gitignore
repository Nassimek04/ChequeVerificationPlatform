# Folders are auto-created at runtime by Directory.CreateDirectory.
src/ChequeVerification.Web/wwwroot/uploads/

# Test-run binary dumps
artifacts/phase12d-tests/

# Dev seed containing a real account number - never push to public repo
artifacts/cmc7_supervisor_customer_seed.sql

